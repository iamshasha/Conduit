<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 window process for WebShell. Launched on demand by webshell.exe
    (the Rust core) and connected to it over a private named pipe; it exits
    when its last window closes.

    Unpackaged + framework-dependent on purpose: it is a helper process the
    core starts, so it uses the Windows App Runtime already on the machine
    instead of an MSIX install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WebShell.Gui</RootNamespace>
    <AssemblyName>WebShell.Gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Makes `dotnet publish` include WebShell.Gui.pri; without it WinUI
         cannot find its theme resources and every window fails to load. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Precompiled IL: noticeably faster window open. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    Component packages instead of the Microsoft.WindowsAppSDK metapackage: the
    metapackage also ships AI/ML runtimes (onnxruntime, DirectML), Widgets and
    Search, ~45 MB this app never loads. Runtime pins the framework version the
    bootstrapper asks Windows for (matches the installed Windows App Runtime 2.5).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings.json" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
